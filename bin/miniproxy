#!/usr/bin/env node
// MiniProxy launcher — delegates to the Python package (riciplay-miniproxy).
//
//   miniproxy <args>  →  python3 -m miniproxy <args>
//
// The Python package is installed by scripts/postinstall.js (pip install
// riciplay-miniproxy). If python3 is missing the user gets a clear error
// rather than a silent failure.

const { spawn } = require('child_process');
const { candidates, check, target } = require('../scripts/runtime');

const args = process.argv.slice(2);
const python = candidates().find(p => check(p));
if (!python) {
  console.error(`Error: matching MiniProxy ${target} on Python 3.12+ with safe, non-overlapping proxy dependencies not found.`);
  console.error('Use a fresh venv and set MINIPROXY_PYTHON to its Python executable. See docs/setup.md.');
  process.exit(1);
}
const proc = spawn(python, ['-m', 'miniproxy', ...args], { stdio: 'inherit' });

proc.on('error', (err) => {
  if (err.code === 'ENOENT') {
    console.error('Error: selected Python executable disappeared. MiniProxy needs Python 3.12+.');
    process.exit(1);
  }
  console.error('Error:', err.message);
  process.exit(1);
});

proc.on('close', (code) => process.exit(code ?? 1));
